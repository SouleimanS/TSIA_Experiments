# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.ipynb_checkpoints/

# === Training outputs / logs (regenerable, often huge) ===
*.jsonl
predictions_*.csv
checkpoints/
runs/
wandb/

# === Model weights and large binaries ===
*.pth
*.pt
*.bin
*.safetensors
*.ckpt

# === Data (videos / audio / arrays — never tracked) ===
*.mp4
*.wav
*.mp3
*.npy
*.npz

# === IDE / env ===
.vscode/
.idea/
.env
.envrc

# === OS junk ===
.DS_Store
Thumbs.db

# === AVHBench heavy artifacts ===
avhbench/AVHBench-Align-FT/bert-base-uncased/
avhbench/AVHBench-Align-FT/models/
avhbench/AVHBench-Align-FT/instruction-dataset/
avhbench/data/AVHBench_v0/
avhbench/**/videos/
avhbench/**/*.log
avhbench/**/*.log.attempt*
avhbench/**/*.pid

# === AV-IB project-specific scratch ===
av_ib/*.qsub.log
av_ib/bad_videos.txt
av_ib/bad_videos_scan.log
av_ib/results/*.csv
av_ib/data/combined_train.json
av_ib/_archive.tar.gz
av_ib/_archive/

# === Scratch backups from in-place editing ===
*.bak

# === Un-ignore the experimental snapshot logs (committed to preserve results) ===
!av_ib/results/logs_snapshot_*/
!av_ib/results/logs_snapshot_*/**/*.jsonl

.claude/worktrees/
