#!/bin/bash
#PBS -N audio_attention
#PBS -P gae50891
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o audio_attention.qsub.log

# Highlight which parts of the audio get the most attention, per AVHBench clip.
set -o pipefail
cd "$PBS_O_WORKDIR"
source /home/aab11336im/anaconda3/etc/profile.d/conda.sh
conda activate av_ib
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export CUDA_VISIBLE_DEVICES=0
echo "=== Node: $(hostname)  Date: $(date) ==="
nvidia-smi -L

CKPT="runs/avqa/video_bottleneck_sft_final.pt"
[ -f "$CKPT" ] || { echo "ERROR: $CKPT missing" >&2; exit 1; }
AVH_VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVHBench/data/AVHBench_v0/video"
OUT_DIR="results/audio_attention"
mkdir -p "$OUT_DIR"

mapfile -t CLIPS < <(find "$AVH_VIDEO_ROOT" -name "*.mp4" | sort | head -30)
echo "Clips: ${#CLIPS[@]}"

for vid in "${CLIPS[@]}"; do
    echo ">>> $(basename $vid)"
    python -u -m av_ib.audio_attention.highlight \
        --video "$vid" \
        --ckpt-path "$CKPT" \
        --variant b_video_only \
        --out-dir "$OUT_DIR" \
    && echo "  OK" || echo "  FAIL"
done

echo "=== Done $(date) ==="
