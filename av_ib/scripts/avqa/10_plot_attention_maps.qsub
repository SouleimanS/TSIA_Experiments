#!/bin/bash
#PBS -N plot_attention_maps
#PBS -P gae50891
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o plot_attention_maps.qsub.log
#PBS -k oe

set -o pipefail
export PYTHONUNBUFFERED=1
cd "$PBS_O_WORKDIR"
# force live streaming regardless of PBS buffering policy
LIVELOG="$PBS_O_WORKDIR/plot_attention_maps.live.log"
exec > >(tee -a "$LIVELOG") 2>&1
echo "Live log: $LIVELOG"
source /home/aab11336im/anaconda3/etc/profile.d/conda.sh
conda activate av_ib
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
echo "=== Node: $(hostname)  Date: $(date) ==="
nvidia-smi -L

# ── quick diagnostic: does the model load at all? ────────────────────────────
echo "--- testing model load ---"
python -u -c "
import traceback, sys
try:
    from av_ib.model.av_model_v6 import AVModelV6
    m = AVModelV6(use_lora=False, variant='b_topk_nofusion').eval()
    print('model load OK', flush=True)
    print('visual encoder:', type(m.qwen.visual_encoder).__name__, flush=True)
except Exception:
    traceback.print_exc()
    sys.exit(1)
"
echo "--- model load test exit=$? ---"

AVH_VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVHBench/data/AVHBench_v0/video"
AVQA_VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVQA/videos"

# ── output lands in a temp dir on the node's local scratch ──────────────────
TMPOUT=$(mktemp -d)
trap 'rm -rf "$TMPOUT"' EXIT   # always clean up node-local temp on exit

FINAL_DIR="$PBS_O_WORKDIR/results/attention_maps"
mkdir -p "$FINAL_DIR"

run_attn() {
    # $1 = label, $2 = video path, $3 = ckpt (empty string = untrained)
    local label="$1" video="$2" ckpt="$3"
    local ckpt_arg=""
    [ -n "$ckpt" ] && ckpt_arg="--ckpt-path $ckpt"
    local subdir="$TMPOUT/$label"
    mkdir -p "$subdir"
    echo ">>> $label  video=$(basename $video)"
    python -u -m av_ib.eval.plot_llm_attention_maps \
        --video "$video" \
        --out-dir "$subdir" \
        --variant b_topk_nofusion \
        --n-frames 6 \
        --last-n-layers 8 \
        --question "What is happening in this video?" \
        $ckpt_arg \
    && { echo "  OK $label"; cp "$subdir"/*.png "$FINAL_DIR/$label/" 2>/dev/null || true; } \
    || echo "  FAIL $label"
}

# ── pick a few representative clips ─────────────────────────────────────────
# AVHBench — grab the first 3 clips present
mapfile -t AVH_CLIPS < <(find "$AVH_VIDEO_ROOT" -name "*.mp4" | sort | head -3)
# AVQA — grab 2 clips
mapfile -t AVQA_CLIPS < <(find "$AVQA_VIDEO_ROOT" -name "*.mp4" | sort | head -2)

# pre-create label subdirs in FINAL_DIR
for label in avhbench_untrained avqa_untrained avhbench_v6b_base avqa_v6b_base; do
    mkdir -p "$FINAL_DIR/$label"
done

# ── untrained baseline ───────────────────────────────────────────────────────
for vid in "${AVH_CLIPS[@]}";  do run_attn "avhbench_untrained"   "$vid" ""; done
for vid in "${AVQA_CLIPS[@]}"; do run_attn "avqa_untrained"       "$vid" ""; done

# ── video bottleneck (base) ──────────────────────────────────────────────────
if [ -f runs/avqa/v6b_base_final.pt ]; then
    for vid in "${AVH_CLIPS[@]}";  do run_attn "avhbench_v6b_base" "$vid" "runs/avqa/v6b_base_final.pt"; done
    for vid in "${AVQA_CLIPS[@]}"; do run_attn "avqa_v6b_base"     "$vid" "runs/avqa/v6b_base_final.pt"; done
else
    echo "SKIP v6b_base (no checkpoint)"
fi

echo "=== Done $(date) ==="
# trap handles rm -rf "$TMPOUT"
