#!/bin/bash
#PBS -N avqa_vidvib_sft
#PBS -P gae50891
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o avqa_vidvib_sft.qsub.log

# Condition 2: video bottleneck (frozen LLM) trained with SFT on the same pairs.

set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p "$PBS_O_WORKDIR/runs/avqa"
source /home/aab11336im/anaconda3/etc/profile.d/conda.sh
conda activate av_ib
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export CUDA_VISIBLE_DEVICES=0
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
echo "=== Node: $(hostname)  Date: $(date) ==="
nvidia-smi -L

ANN_TRAIN="$HOME/SOULEIMAN_repo/datasets/AVQA/train_qa.json"
ANN_VAL="$HOME/SOULEIMAN_repo/datasets/AVQA/val_qa.json"
VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVQA/videos"
[ -f "$ANN_TRAIN" ] || { echo "ERROR: $ANN_TRAIN missing — run 1_download_dataset.py" >&2; exit 1; }
N_CLIPS=$(find "$VIDEO_ROOT" -name "*.mp4" | wc -l)
[ "$N_CLIPS" -ge 20000 ] || { echo "ERROR: only $N_CLIPS clips in $VIDEO_ROOT — wait for 1_download_dataset.py to finish." >&2; exit 1; }
exec > >(tee -a "$PBS_O_WORKDIR/runs/avqa/avqa_vidvib_sft_out.txt") 2>&1

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
LABELS="$PBS_O_WORKDIR/runs/avqa/abstention_labels.json"
[ -f "$LABELS" ] || { echo "ERROR: $LABELS missing — run 2_mine_abstention_labels first." >&2; exit 1; }
python -u -m av_ib.train.train_sft_abstain \
    --labels-json "$LABELS" --video-root "$VIDEO_ROOT" \
    --variant b_video_only \
    --num-steps 400 --lr 5e-5 \
    --log-path runs/avqa/video_bottleneck_sft.jsonl \
    --ckpt-path runs/avqa/video_bottleneck_sft_final.pt

echo "=== Done $(date) ==="
