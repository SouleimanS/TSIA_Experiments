#!/bin/bash
#PBS -N perceive_attn
#PBS -P gae50891
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o perceive_attn.qsub.log
#PBS -k oe

# Three-way attention comparison: Raw | VIB only | VIB + Perception.
# Runs plot_attention for 5 clips (3 AVHBench + 2 AVQA) from a trained
# AVModelPerceive checkpoint. Reports norm_entropy and top5pct_mass per
# condition and saves side-by-side heatmap figures.

set -o pipefail
export PYTHONUNBUFFERED=1
cd "$PBS_O_WORKDIR"
LIVELOG="$PBS_O_WORKDIR/perceive_attn.live.log"
exec > >(tee -a "$LIVELOG") 2>&1
echo "Live log: $LIVELOG"
source /home/aab11336im/anaconda3/etc/profile.d/conda.sh
conda activate av_ib
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
echo "=== Node: $(hostname)  Date: $(date) ==="
nvidia-smi -L

AVH_VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVHBench/data/AVHBench_v0/video"
AVQA_VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVQA/videos"
CKPT="runs/perceive/perceive_final.pt"
[ -f "$CKPT" ] || { echo "ERROR: $CKPT missing" >&2; exit 1; }

TMPOUT=$(mktemp -d)
trap 'rm -rf "$TMPOUT"' EXIT
FINAL_DIR="$PBS_O_WORKDIR/results/perceive_attention"
mkdir -p "$FINAL_DIR"

run_one() {
    local video="$1"
    echo ">>> $(basename $video)"
    python -u -m av_ib.perceive_reason.plot_attention \
        --video "$video" \
        --ckpt-path "$CKPT" \
        --variant b_topk_nofusion \
        --n-frames 6 \
        --last-n-layers 8 \
        --out-dir "$TMPOUT" \
    && { echo "  OK"; cp "$TMPOUT"/*"$(basename ${video%.*})"* "$FINAL_DIR/" 2>/dev/null || true; } \
    || echo "  FAIL"
}

# 3 AVHBench clips
mapfile -t AVH_CLIPS  < <(find "$AVH_VIDEO_ROOT"  -name "*.mp4" | sort | head -3)
# 2 AVQA clips
mapfile -t AVQA_CLIPS < <(find "$AVQA_VIDEO_ROOT" -name "*.mp4" | sort | head -2)

for vid in "${AVH_CLIPS[@]}";  do run_one "$vid"; done
for vid in "${AVQA_CLIPS[@]}"; do run_one "$vid"; done

echo "=== Done $(date) ==="