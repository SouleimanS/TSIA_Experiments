#!/bin/bash
#PBS -N token_analysis
#PBS -P gae50891
#PBS -q rt_HF
#PBS -l walltime=02:00:00
#PBS -l select=1
#PBS -j oe
#PBS -o token_analysis.qsub.log

cd "$PBS_O_WORKDIR"
source /home/aab11336im/anaconda3/etc/profile.d/conda.sh
conda activate av_ib
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
echo "=== Node: $(hostname)  Date: $(date) ==="
nvidia-smi -L

CKPT="runs/avqa/video_bottleneck_sft_final.pt"
[ -f "$CKPT" ] || { echo "ERROR: $CKPT missing" >&2; exit 1; }

AVH_VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVHBench/data/AVHBench_v0/video"
AVQA_VIDEO_ROOT="$HOME/SOULEIMAN_repo/datasets/AVQA/videos"
OUT_DIR="results/token_analysis"
mkdir -p "$OUT_DIR"

mapfile -t AVH_CLIPS  < <(find "$AVH_VIDEO_ROOT"  -name "*.mp4" | sort | head -5)
mapfile -t AVQA_CLIPS < <(find "$AVQA_VIDEO_ROOT" -name "*.mp4" | sort | head -5)

VIDEO_ARGS=()
for f in "${AVH_CLIPS[@]}";  do VIDEO_ARGS+=(--video "$f"); done
for f in "${AVQA_CLIPS[@]}"; do VIDEO_ARGS+=(--video "$f"); done

echo "Clips: ${#VIDEO_ARGS[@]} --video args"

export CUDA_VISIBLE_DEVICES=0
python -u -m av_ib.token_analysis.analyse \
    "${VIDEO_ARGS[@]}" \
    --ckpt-path "$CKPT" \
    --variant b_video_only \
    --out-dir "$OUT_DIR" \
    --last-n-layers 8

echo "=== Done $(date) ==="
